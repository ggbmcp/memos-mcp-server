# Memos MCP Server Configuration
# Copy this file to .env and fill in your values

# Memos server URL (e.g., http://localhost:5230)
MEMOS_SERVER_URL=http://localhost:5230

# Memos API token (get from your memos settings)
MEMOS_API_TOKEN=your_api_token_here

# Optional: User ID (if needed for your memos instance)
# MEMOS_USER_ID=1

# Optional: Default visibility for new memos (public/private)
DEFAULT_VISIBILITY=private

# Optional: Default resource limit for queries
DEFAULT_RESOURCE_LIMIT=50