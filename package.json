{
  "name": "@ggbmcp/memos-mcp-server",
  "version": "1.0.1",
  "description": "MCP Server for Memos - A Model Context Protocol server for interacting with Memos notes application",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "memos-mcp-server": "bin/memos-mcp-server.js"
  },
  "scripts": {
