  ],
  "author": "ggbmcp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggbmcp/memos-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/ggbmcp/memos-mcp-server/issues"
  },
  "homepage": "https://github.com/ggbmcp/memos-mcp-server#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE",
    ".env.example",
    "claude-desktop-config.json"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
